/* ================================================================= */
/* === Container =================================================== */

    .kfsmew-container
    {
	    flex-grow: 1;
        flex-shrink: 1;
        flex-direction: column;
    }

    /* ================================================================= */
    /* === Header ====================================================== */
        .kfsmew-header
        {
            flex-shrink: 1;
            height: 50px;
            border-width: 1px;
            background-color: rgb(30, 30, 30);
            border-color: rgb(10, 13, 13);
            font-size: 18px;
            -unity-font-style: bold;
            justify-content: flex-start;
            flex-direction: row;
            align-items: center;
            padding: 5px;
        }
        .kfsmew-header-title-label
        {
            padding-left: 5px;
        }

        .kfsmew-header-title-textfield
        {
            padding-left: 5px;
        }
    /* ================================================================= */

    /* ================================================================= */
    /* === Split View ================================================== */
        .kfsmew-split-view
        {
            flex-grow: 1;
            flex-shrink: 1;
        }

        /* ================================================================= */
        /* === States Pane ================================================= */
            .kfsmew-split-view-states-pane
            {
                flex-grow: 1;
                min-width: 150px;
            }

            /* ================================================================= */
            /* === Toolbar ===================================================== */
                .kfsmewsv-states-pane-toolbar
                {

                }

                .kfsmewsvspt-search-field-state
                {
                    flex-grow: 1;
                    flex-shrink: 1;
                    min-width: 0px;
                    width: 0px;
                }

                .kfsmewsvspt-button-add-state
                {
                    margin-left: auto;
                    flex-shrink: 0;
                    min-width: 30px;
                    width: 30px;
                    border-width: 0px;
                    font-size: 14px;
                    -unity-font-style: bold;
                }
            /* ================================================================= */

            /* ================================================================= */
            /* === List View =================================================== */
                .kfsmewsvspt-list-view
                {
                    width: 100%;
                    height: 100%;
                    flex-direction: column;
                }

                /* ================================================================= */
                /* === List View Item ============================================== */
                    .kfsmewsvspt-list-view-item
                    {
                        height: 40px;
                        flex-direction: row;
                        border-bottom-width: 1px;
                        border-bottom-color: rgb(66, 66, 66);
                        justify-content: flex-start;
                    }

                    .kfsmewsvspt-list-view-item-label
                    {
                        align-self: center;
                        flex-grow: 1;
                        flex-shrink: 1;

                        font-size: 16px;
                        padding-left: 5px;
                    }

                    .kfsmewsvspt-list-view-item-text-field
                    {
                        font-size: 16px;
                        padding-left: 5px;
                    }
                /* ================================================================= */
            /* ================================================================= */
        /* ================================================================= */
    
        /* ================================================================= */
        /* === Inspector Pane ============================================== */
            .kfsmew-split-view-inspector-pane
            {
                flex-grow: 1;
                flex-shrink: 1;
            }
            /* ================================================================= */
            /* === Toolbar ===================================================== */
            /* ================================================================= */
                .kfsmewsvip-toolbar
                {
                }
            /* ================================================================= */

            /* ================================================================= */
            /* === Split View ================================================== */
            /* ================================================================= */
                .kfsmewsvip-split-view
                {
                    flex-grow: 1;
                    flex-shrink: 1;
                }

                /* ================================================================= */
                /* === Transition Pane ============================================= */
                /* ================================================================= */
                    .kfsmewsvip-split-view-state-transition-pane
                    {
                        flex-grow: 1;
                        width: 150px;
                        min-width: 150px;
                        max-width: 150px;
                    }
                    .kfsmewsvipsvstpt-popup-search-field-state-transition
                    {
                        flex-grow: 1;
                        flex-shrink: 1;
                        min-width: 0px;
                        width: 0px;
                    }

                    .kfsmewsvipsvstpt-menu-add-state-transition
                    {
                        margin-left: auto;
                        flex-shrink: 0;
                        min-width: 30px;
                        width: 30px;
                        border-width: 0px;
                        font-size: 14px;
                        -unity-font-style: bold;
                    }

                    /* ================================================================= */
                    /* === Toolbar ===================================================== */
                        .kfsmewsvip-svstp-toolbar
                        {
                            
                        }

                        /* ================================================================= */
                        /* === Popup Search Field ========================================== */
                            .kfsmewsvipsvstpt-popup-search-field-state-transition
                            {
                            }

                            .kfsmewsvipsvstpt-popup-search-field-state-transition .unity-text-field__input
                            {
                                padding-right: 3px;
                            }
                        /* ================================================================= */
                    /* ================================================================= */

                    /* ================================================================= */
                    /* === List View =================================================== */
                        .kfsmewsvipsvstp-list-view
                        {

                        }

                        .kfsmewsvipsvstp-list-view-item
                        {
                            height: 20px;
                            padding-left: 5px;
                            border-bottom-width: 1px;
                            border-bottom-color: rgb(66, 66, 66);
                            -unity-text-align: middle-left;
                            justify-content: center;
                        }
                    /* ================================================================= */
                /* ================================================================= */

                /* ================================================================= */
                /* === Inspector Pane ============================================== */
                /* ================================================================= */
                    .kfsmewsvip-split-view-inspector-pane
                    {
                        flex-grow: 1;
                        flex-shrink: 1;
                    }

                    /* ================================================================= */
                    /* === Scroll View ================================================= */
                        .kfsmewsvip-scroll-view-content
                        {
                            flex-grow: 1;
                            flex-shrink: 1;       
                                            
                        }
                        /* ================================================================= */
                        /* === Item Base =================================================== */
                            .kfsmewsvipsvc-item-base
                            {    
                                padding: 5px;
                                flex-direction: column;
                                justify-content: flex-start;
                                border-bottom-width: 1px;
                                border-bottom-color: rgba(66, 66, 66, 1);
                            }

                            /* ================================================================= */
                            /* === List ======================================================== */
                                .kfsmewsvipsvc-item-list
                                {
                                    flex-grow: 1;
                                    flex-shrink: 1;
                                }

                                /* ================================================================= */
                                /* === Button ====================================================== */
                                    .kfsmewsvipsvc-item-list-button-container
                                    {
                                        padding: 5px;
                                        background-color: rgba(0, 0, 0, 0.1);
                                        border-width: 1px;
                                        border-color: rgba(30, 30, 30, 1);
                                        
                                        padding: 1px;
                                        flex-direction: row;
                                        justify-content: flex-start;
                                        position: absolute;
                                        bottom: 0px;
                                        right: 5px;
                                    }

                                    .kfsmewsvipsvc-item-list-button
                                    {
                                        border-width: 0px;
                                        width: 20px;
                                        height: 20px;
                                        align-self: center;
                                        -unity-font-style: bold;
                                        font-size: 14px;
                                        background-color: rgba(45, 45, 45, 1);
                                    }
                                    .kfsmewsvipsvc-item-list-button:hover
                                    {
                                        background-color: rgba(60, 60, 60, 1);
                                    }
                                    .kfsmewsvipsvc-item-list-button:active
                                    {
                                        background-color: rgba(90, 90, 90, 1);
                                    }
                                /* ================================================================= */

                                /* ================================================================= */
                                /* === Item ======================================================== */
                                    .kfsmewsvipsvipsvcil-condition-item
                                    {
                                        width: 100%;
                                        height: 30px;
                                        flex-direction: row;
                                        align-items: center;
                                        justify-content: flex-start;
                                    }

                                    .kfsmewsvipsvipsvcil-condition-item-parameter1
                                    {
                                        
                                        margin-right: auto;
                                        min-width: 40%;
                                        flex-grow: 0;
                                    }
                                    .kfsmewsvipsvipsvcil-condition-item-operation
                                    {
                                        
                                        margin-right: auto;
                                        min-width: 20%;
                                        flex-grow: 0;
                                    }
                                    .kfsmewsvipsvipsvcil-condition-item-parameter2-container
                                    {
                                        flex-direction: row;
                                        margin-right: auto;
                                        min-width: 40%;
                                        flex-grow: 0;
                                    }
                                    .kfsmewsvipsvipsvcil-condition-item-parameter2-container-item
                                    {
                                        min-width: 50%;
                                        flex-grow: 1;
                                    }
                                    .kfsmewsvipsvipsvcil-condition-item-parameter2-container-item-none
                                    {
                                        min-width: 20%;
                                        max-width: 20%;
                                    }

                                /* ================================================================= */
                            /* ================================================================= */

                            /* ================================================================= */
                            /* === Group ======================================================= */
                                .kfsmewsvipsvc-item-group
                                {   
                                    margin: 5px;
                                    flex-direction: column;
                                    justify-content: flex-start;
                                    border-width: 1px;
                                    border-color: rgba(0, 0, 0, 0.4);
                                }

                                /* ================================================================= */
                                /* === Transition ================================================== */
                                    .kfsmewsvipsvipsvcig-transition
                                    {
                                        position: relative;
                                        border-color: rgba(0, 0, 0, 0.3);
                                        border-width: 1px;
                                        
                                        flex-shrink: 1;
                                        justify-content: flex-end;
                                        
                                        /*padding-bottom: 30px;*/
                                    }

                                    .kfsmewsvipsvipsvcig-transition-button-container
                                    {
                                        position: absolute;
                                        bottom: 6px;
                                        right: 15px;
                                        border-color: rgba(0, 0, 0, 0.3);
                                        border-width: 1px;
                                        border-top-width: 0px;
                                        background-color: rgb(45, 45, 45);
                                        padding: 1px;
                                        flex-direction: row;
                                        justify-content: flex-start;
                                    }

                                    .kfsmewsvipsvipsvcig-transition-button
                                    {
                                        width: 20px;
                                        background-color: rgba(45, 45, 45, 1);
                                        font-size: 14px;
                                        -unity-font-style: bold;
                                        align-self: center;
                                        border-width: 0px;
                                    }
                                    .kfsmewsvipsvipsvcig-transition-button:hover
                                    {
                                        background-color: rgba(60, 60, 60, 1);
                                    }
                                    .kfsmewsvipsvipsvcig-transition-button:hover:active
                                    {
                                        background-color: rgba(75, 75, 75, 1);
                                    }
                                /* ================================================================= */

                                /* ================================================================= */
                                /* === Header ====================================================== */
                                    .kfsmewsvipsvc-item-group-header
                                    {
                                        padding: 5px;
                                        border-width: 1px;
                                        border-color: rgba(1, 1, 1, 0.2);
                                        background-color: rgba(0, 0, 0, 0.2);
                                        flex-direction: row;
                                    }
                                    .kfsmewsvipsvc-item-group-header-name
                                    {
                                        font-size: 18px;
                                        -unity-font-style: bold;
                                    }
                                    .kfsmewsvipsvc-item-group-header-toggle
                                    {
                                        margin-left: auto;
                                        background-color: rgba(0, 0, 0, 0);
                                        border-width: 0px;
                                    }
                                    .kfsmewsvipsvc-item-group-header-toggle:hover
                                    {
                                        background-color: rgba(0, 0, 0, 0.2);
                                    }
                                    .kfsmewsvipsvc-item-group-header-toggle:active
                                    {
                                        background-color: rgba(0, 0, 0, 0.4);
                                    }
                                /* ================================================================= */

                                /* ================================================================= */
                                /* === Content ===================================================== */
                                    .kfsmewsvipsvc-item-group-content
                                    {
                                        padding: 5px;
                                        flex-direction: column;
                                        justify-content: flex-start;
                                        background-color: rgba(0, 0, 0, 0.1);
                                        border-width: 1px;
                                        border-color: rgba(0, 0, 0, 0.4);
                                        border-top-width: 0px;
                                    }
                                /* ================================================================= */
                            /* ================================================================= */

                            /* ================================================================= */
                            /* === Field ======================================================= */
                                .kfsmewsvipsvc-item-field
                                {
                                    flex-direction: row;
                                    justify-content: flex-start;    
                                    align-items: center;
                                } 

                                .kfsmewsvipsvc-item-field-label
                                {
                                    margin-right: auto;
                                    flex-shrink: 1;
                                    flex-grow: 0;
                                    min-width: 250px;
                                    width: auto;
                                    font-size: 12px;
                                }
                                .kfsmewsvipsvc-item-field-value
                                {
                                    width: auto;
                                    min-width: 250px;
                                    margin-left: 5px;
                                    margin-right: 5px;
                                    flex-shrink: 1;
                                    flex-grow: 1;
                                }
                            /* ================================================================= */
                        /* ================================================================= */
                    /* ================================================================= */

                    /* ================================================================= */
                /* ================================================================= */
            /* ================================================================= */
        /* ================================================================= */
    /* ================================================================= */
/* ================================================================= */

